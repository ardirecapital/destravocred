PORT=3000

# Webhook do n8n que receberá os dados e arquivos do lead.
# Exemplo: https://SEU-N8N/webhook/ardire-credito
N8N_WEBHOOK_URL=

# Para desenvolvimento local apenas.
# Se true e N8N_WEBHOOK_URL estiver vazio, as solicitações serão salvas em ./data/submissions.
ALLOW_LOCAL_DEV_STORAGE=false

# Raio de atendimento em km
SERVICE_RADIUS_KM=50

# Coordenadas aproximadas do centro de Franca/SP
FRANCA_LAT=-20.5386
FRANCA_LON=-47.4008
